{
  "name": "srujan-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run -s graph",
    "build": "next build",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "verify": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/verify-phase.mts",
    "content:dump": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/content-dump.mts",
    "graph": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-graph.mts",
    "test:unit": "vitest run",
    "worker:check": "npm --prefix worker run typecheck && npm --prefix worker run build",
    "lighthouse": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/lighthouse.mts",
    "axe": "axe http://localhost:4321/ --tags wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa --exit",
    "release:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/release-check.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "minisearch": "^7.2.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^12.8.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.6"
  }
}
